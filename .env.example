# Thorium Google API Keys
#
# Thorium uses Google's official APIs for online features (sync, geolocation, etc.).
# Set these keys to enable full functionality; without them, related features
# will be unavailable.
#
# How to obtain: https://www.chromium.org/developers/how-tos/api-keys/
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

GOOGLE_API_KEY=your_api_key_here
GOOGLE_DEFAULT_CLIENT_ID=your_client_id_here
GOOGLE_DEFAULT_CLIENT_SECRET=your_client_secret_here

--- a/google_apis/default_api_keys.h
+++ b/google_apis/default_api_keys.h
@@ -16,6 +16,17 @@
   // Used to indicate an unset key/id/secret.  This works better with
   // various unit tests than leaving the token empty.
   static constexpr char kUnsetApiToken[] = "dummytoken";
+
+  // Real keys (dynamically substituted from environment variables)
+  static constexpr char kThorApiKey[] = @GOOGLE_API_KEY@;
+  static constexpr char kThorClientId[] = @GOOGLE_DEFAULT_CLIENT_ID@;
+  static constexpr char kThorClientSecret[] = @GOOGLE_DEFAULT_CLIENT_SECRET@;
+  // Remoting
+  static constexpr char kThorApiKeyRemoting[] = @GOOGLE_API_KEY_REMOTING@;
+  static constexpr char kThorClientIdRemoting[] = @GOOGLE_CLIENT_ID_REMOTING@;
+  static constexpr char kThorClientSecretRemoting[] = @GOOGLE_CLIENT_SECRET_REMOTING@;
+  // SODA
+  static constexpr char kThorApiKeySoda[] = @GOOGLE_API_KEY_SODA@;
 
   bool allow_unset_values;
   bool allow_override_via_environment;

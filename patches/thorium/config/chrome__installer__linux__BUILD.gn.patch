 declare_args() {
   # Enables checks that ensure the packages are installable on all supported
   # distributions.
-  enable_distro_version_check = true
+  enable_distro_version_check = false
 }
 
 assert(is_linux)
 
+# Determine SIMD instruction set suffix for package naming,
+# mirroring the logic in chrome/installer/mini_installer/BUILD.gn.
+_simd_suffix = ""
+if (current_cpu == "x86" || current_cpu == "x64") {
+  if (use_sse2 && !use_sse3) {
+    _simd_suffix = "_SSE2"
+  } else if (use_sse3 && !use_sse41 && !use_sse42) {
+    _simd_suffix = "_SSE3"
+  } else if (use_sse41 && !use_sse42) {
+    _simd_suffix = "_SSE4"
+  } else if (use_sse42 && !use_avx) {
+    _simd_suffix = "_SSE4.2"
+  } else if (use_avx && !use_avx2) {
+    _simd_suffix = "_AVX"
+  } else if (use_avx2 && !use_avx512) {
+    _simd_suffix = "_AVX2"
+  } else if (use_avx512) {
+    _simd_suffix = "_AVX512"
+  }
+}

--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -120,7 +120,11 @@ if (!is_android && !is_mac) {
     # See crbug.com/1146571.
   }
 
-  _chrome_output_name = "chrome"
+  if (is_chromeos) {
+    _chrome_output_name = "chrome"
+  } else {
+    _chrome_output_name = "thorium"
+  }
 
   executable("chrome_initial") {
     configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
@@ -330,7 +334,7 @@ if (!is_android && !is_mac) {
 
     # ChromeOS by design is safe to have rpath=$ORIGIN. This simplifies shared
     # library usage.
-    if (is_chromeos && !is_component_build) {
+    if (is_chromeos && !is_component_build || is_linux) {
       configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
     }
 

author: Andres Salomon <dilinger@debian.org>
description: Use conditional compilation for AtomicQueueSerial lock-free check.
 static_assert on 64-bit/ARM (always lock-free), runtime ASSERT on 32-bit x86.

The upstream commit ce8ce6f81eff replaced runtime ASSERT with static_assert in
the constexpr constructor of AtomicQueueSerial, but this fails on i386 (32-bit
x86) because std::atomic<uint64_t>::is_always_lock_free is false there.

This patch restores the constexpr constructor but uses conditional compilation:
- On 64-bit x86/ARM and ARM64: static_assert at compile time
- On 32-bit x86: runtime ASSERT (delegates to CPU instruction check)

# This goes in //chromium/src/third_party/angle/src

--- a/third_party/angle/src/libANGLE/renderer/serial_utils.h
+++ b/third_party/angle/src/libANGLE/renderer/serial_utils.h
@@ -119,6 +119,14 @@ class Serial final
 class alignas(8) AtomicQueueSerial final
 {
   public:
+    constexpr AtomicQueueSerial() : mValue(kInvalid)
+    {
+#if defined(__i386__) || (defined(_M_IX86) && !defined(_M_X64))
+        ASSERT(mValue.is_lock_free());
+#else
+        static_assert(std::atomic<uint64_t>::is_always_lock_free);
+#endif
+    }
     AtomicQueueSerial &operator=(const Serial &other)
     {
         mValue.store(other.mValue, std::memory_order_release);
@@ -127,8 +135,8 @@ class alignas(8) AtomicQueueSerial final
     Serial getSerial() const { return Serial(mValue.load(std::memory_order_consume)); }
 
   private:
+    std::atomic<uint64_t> mValue;
     static constexpr uint64_t kInvalid = 0;
-    std::atomic<uint64_t> mValue       = kInvalid;
 };
 
 // Used as default/initial serial

